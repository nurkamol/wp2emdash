---
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead, WidgetArea } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { env } from "cloudflare:workers";
import SiteHeader from "../components/SiteHeader.astro";
import Announcement from "../components/Announcement.astro";
import Sections from "../components/Sections.astro";
import Popups from "../components/Popups.astro";
import StructuredData from "../components/StructuredData.astro";
import BusinessInfo from "../components/BusinessInfo.astro";
import Analytics from "../components/Analytics.astro";
import Consent from "../components/Consent.astro";
import SiteWidgets from "../components/SiteWidgets.astro";
import site from "../site.config.json";
import { announcementState, type Chrome, loadChrome } from "../utils/chrome";
import { pageLanguages } from "../utils/i18n-data";
import { homeOf } from "../utils/i18n";
import type { Crumb } from "../utils/breadcrumbs";
import { safeHref } from "../utils/links";
import { isEditor } from "../utils/editor";
import { motionFor } from "../utils/motion";
import { MOTION_CSS, MOTION_JS, VIEW_TRANSITION_CSS } from "@wp2emdash/motion/settings";
import { brandMediaIds, brandMediaRows, sameAsWithSocial, type SettingsData, siteBrand, socialHrefFor, verificationTags, withSocial } from "../utils/settings";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/base.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	/** `group`: the entry's translation group (multilingual sites: hreflang alternates and the language switcher). */
	content?: { collection: string; id: string; slug?: string | null; group?: string | null; lang?: string | null };
	/** First section is a full-bleed hero: the header starts transparent over it. */
	overHero?: boolean;
	/** Site chrome the page loaded (utils/chrome.ts). */
	chrome?: Chrome;
	/** A blog post: EmDash prints article meta and BlogPosting structured data from these. */
	article?: { publishedTime?: string | null; modifiedTime?: string | null; author?: string | null };
	/** Extra RSS feeds of this page (an archive's own feed), after the site feed. */
	feeds?: { title: string; href: string }[];
	/** Show the blog sidebar (the old theme's sidebar widget area, site.config.json widgetAreas.sidebar) next to the content. */
	sidebar?: boolean;
	/** Visible breadcrumbs (utils/breadcrumbs.ts); the BreadcrumbList structured data follows the same trail. */
	breadcrumbs?: Crumb[];
}
const { title, pageTitle, description, image, canonical, robots, content, overHero, chrome: chromeProp, article, feeds: extraFeeds = [], sidebar: withSidebar, breadcrumbs } = Astro.props;
// Blog sites: the site feed on every page (WordPress printed it in every page's head), plus the page's own.
const blogFeed = (site as { blog?: unknown }).blog ? [{ title: "Feed", href: (site as { trailingSlash?: string }).trailingSlash === "never" ? "/feed" : "/feed/" }] : [];

// Site chrome: loaded by the page (route-cache tags must be set before the response streams: utils/chrome.ts), or here
// for a page that did not pass it.
const chrome = chromeProp ?? (await loadChrome(Astro.url.pathname));
const { settings, primary, secondary, footer, popups } = chrome;
// Classic-theme widget areas and footer menu, only on sites where the old theme showed them (utils/chrome.ts).
const footerAreas = (site as { widgetAreas?: { footer?: string[] } }).widgetAreas?.footer ?? [];
const sidebarAreas = withSidebar ? ((site as { widgetAreas?: { sidebar?: string[] } }).widgetAreas?.sidebar ?? []) : [];
const footerMenuItems = (chrome.footerMenu?.data?.items ?? []) as { label: string; url: string; target?: string | null }[];
// Announcement bar: decided in the browser too (components/Announcement.astro), since a cached page outlives the
// request that rendered it. A bar whose schedule has ended is left out; one that starts later is rendered hidden.
const { block: announcement, later: announcementLater } = announcementState(chrome);

const siteTitle = settings.data?.title?.trim() || site.name;
/** Footer credit (kit.config credit; scaffold leaves it out when the migrated footer already has one). */
const siteCredit = (site as { credit?: { text: string; name: string; url: string } }).credit;
// Sharing image on the host serving this page: before go-live the production domain still serves WordPress, which has
// no /_emdash/ files, so link previews of the workers.dev or staging address would find no image. og:url and the
// canonical keep the production address.
// EmDash's getSeoMeta already makes it absolute on the production address: that origin is swapped for this one too.
// The request's own URL, not Astro.url (which reports the configured `site` address in production builds).
const servingOrigin = new URL(Astro.request.url).origin;
const ogCards = (site as { ogCards?: boolean }).ogCards === true;
const productionOrigin = URL.canParse(site.productionUrl) ? new URL(site.productionUrl).origin : undefined;
const ogImage = image ? (() => {
	const u = new URL(image, servingOrigin);
	return u.origin === productionOrigin || !/^https?:\/\//.test(image) ? new URL(`${u.pathname}${u.search}`, servingOrigin).toString() : u.toString();
})() : undefined;
// Its size and type from EmDash's media library (link previews use them to lay out the card before fetching).
let ogImageMeta: { width?: number; height?: number; type?: string } = {};
const ogKey = image ? /\/_emdash\/api\/media\/file\/([^/?#]+)$/.exec(image)?.[1] : undefined;
const db = (env as { DB?: { prepare(q: string): { bind(...v: unknown[]): { first<T>(): Promise<T | null>; all<T>(): Promise<{ results?: T[] }> } } } }).DB;
if (ogKey && db && !ogCards) {
	try {
		const row = await db.prepare("SELECT width, height, mime_type FROM media WHERE storage_key = ? LIMIT 1").bind(decodeURIComponent(ogKey)).first<{ width: number | null; height: number | null; mime_type: string | null }>();
		if (row) ogImageMeta = { ...(row.width ? { width: row.width } : {}), ...(row.height ? { height: row.height } : {}), ...(row.mime_type?.startsWith("image/") ? { type: row.mime_type } : {}) };
	} catch {}
}
// Settings → General / Social Links / SEO (utils/settings.ts), site.config as the fallback for an empty setting.
const s = settings.data as SettingsData | undefined;
// A page without its own sharing image gets Settings → SEO → Default social image from EmDash's head; its size here.
const defaultOg = !image && !ogCards ? s?.seo?.defaultOgImage : undefined;
if (defaultOg?.url) ogImageMeta = { ...(defaultOg.width ? { width: defaultOg.width } : {}), ...(defaultOg.height ? { height: defaultOg.height } : {}), ...(defaultOg.contentType?.startsWith("image/") ? { type: defaultOg.contentType } : {}) };
type LogoFile = { src: string; width: number; height: number };
const sc = site as unknown as { header: { logoImg?: LogoFile; logo?: string; logoOnTopImg?: LogoFile; logoOnTop?: string; logoHeight?: number }; icons?: { rel: string; href: string; type: string; sizes?: string }[]; favicon?: string; brandSha1?: { logo?: string; favicon?: string }; verification?: Record<string, string>; structuredData?: { business?: { sameAs?: string[] } } };
const header = sc.header;
const brand = siteBrand(s, {
	...(header.logoImg ?? header.logo ? { logo: header.logoImg ?? { src: header.logo as string } } : {}),
	...(header.logoOnTopImg ?? header.logoOnTop ? { logoOnTop: header.logoOnTopImg ?? { src: header.logoOnTop as string } } : {}),
	...(sc.icons ? { icons: sc.icons } : {}),
	...(sc.favicon ? { favicon: sc.favicon } : {}),
	...(header.logoHeight ? { logoHeight: header.logoHeight } : {}),
	...(sc.brandSha1 ? { brandSha1: sc.brandSha1 } : {}),
}, await brandMediaRows(db, brandMediaIds(s)));
const verification = verificationTags(s, sc.verification);
// Motion (Plugins → Motion, utils/motion.ts): nothing is added while it is off, so the page stays as it was.
const motion = motionFor(chrome.motion?.settings, { url: Astro.url, editor: isEditor(Astro.cookies, Astro.url), hasLogo: !!brand.logo, hasLightLogo: !!brand.logoOnTop });
const preloaderLogo = motion.preloader ? (motion.preloader.logo === "onTop" ? brand.logoOnTop : brand.logo) : undefined;
const footerContent = footer.entry ? withSocial((footer.entry.data as any).content, s) : undefined;
const business = sc.structuredData?.business;
const sameAs = business ? sameAsWithSocial(business.sameAs, s) : undefined;
const sep = settings.data?.seo?.titleSeparator?.trim() || "-";
// The page's own title gets " – Site"; an SEO title of its own (different from the page title) is used as written,
// as WordPress SEO plugins print a custom title ("Member Login" on the Account page).
const customTitle = !!title && !!pageTitle && title.trim() !== pageTitle.trim();
const fullTitle = title ? (customTitle || title.includes(siteTitle) ? title : `${title} ${sep} ${siteTitle}`) : siteTitle;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: article ? "article" : "website",
	...(article ? { articleMeta: article } : {}),
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || settings.data?.tagline || undefined,
	canonical: canonical ?? `${site.productionUrl}${Astro.url.pathname}`,
	image: ogImage,
	...(content ? { content: { collection: content.collection, id: content.id, ...(content.slug !== undefined ? { slug: content.slug } : {}) } } : {}),
	seo: { ogImage, robots },
	siteName: siteTitle,
	// EmDash makes the page entry's SEO image absolute with this address, and that value wins over `seo.ogImage`.
	// On the production domain: the production address (structured-data ids stay stable). Anywhere else (workers.dev
	// before go-live, staging): the serving address, so link previews can fetch the image — the production domain
	// serves WordPress until the switch. Canonical and og:url keep the production address either way.
	siteUrl: servingOrigin === productionOrigin ? site.productionUrl : servingOrigin,
});
const canonicalUrl = canonical ?? `${site.productionUrl}${Astro.url.pathname}`;
// Multilingual sites (site.config.json `i18n`): the page's language, its hreflang alternates on the production address
// (as the canonical) and the language switcher (utils/i18n.ts). Undefined on a single-language site.
const langs = await pageLanguages(Astro.url.pathname, productionOrigin ?? servingOrigin, content ? { collection: content.collection, group: content.group ?? null, lang: content.lang ?? null } : undefined);
/** Google Fonts stylesheet, only when the fonts were not self-hosted at scaffold time. */
const googleHref = (site.fonts as { googleHref?: string }).googleHref;
const typekitHref = (site.fonts as { typekitHref?: string }).typekitHref;
---

<!doctype html>
<html lang={langs?.lang.hreflang ?? site.lang} data-prefetch={(site as { prefetch?: boolean }).prefetch === false ? "off" : undefined} {...motion.attrs} class:list={{ "has-announcement": !!announcement && !announcementLater, "motion-calm": motion.calm, "video-phones": (site as { phoneVideo?: boolean }).phoneVideo === true }}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* Motion: its stylesheet and script are files (CSP), linked only when an option needs them; the script runs before
		    the first paint only for the preloader. The View Transitions opt-in is the one rule written here (style-src allows it). */}
		{motion.css && <link rel="stylesheet" href={MOTION_CSS} />}
		{motion.js === "sync" && <script is:inline src={MOTION_JS}></script>}
		{motion.js === "defer" && <script is:inline src={MOTION_JS} defer></script>}
		{motion.viewTransition && <style is:inline set:html={VIEW_TRANSITION_CSS}></style>}
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{/* EmDash's head has no og:locale; SEO plugins publish it (en-US → en_US). */}
		{/* Multilingual: a translation's own locale; its hreflang alternates (self, each translation, x-default). */}
		<meta property="og:locale" content={langs?.lang.prefix ? langs.lang.hreflang.replace("-", "_") : ((site as { ogLocale?: string }).ogLocale ?? (site.lang ?? "en").replace("-", "_"))} />
		{langs?.alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
		{/* With sharing cards (@wp2emdash/og) the plugin sets every og:image tag; otherwise these describe the page's image. */}
		{!ogCards && (ogImage || defaultOg?.url) && <meta property="og:image:alt" content={ogImage ? (pageTitle ?? title ?? siteTitle) : defaultOg?.alt || siteTitle} />}
		{!ogCards && ogImageMeta.width && <meta property="og:image:width" content={String(ogImageMeta.width)} />}
		{!ogCards && ogImageMeta.height && <meta property="og:image:height" content={String(ogImageMeta.height)} />}
		{!ogCards && ogImageMeta.type && <meta property="og:image:type" content={ogImageMeta.type} />}
		<StructuredData canonical={canonicalUrl} pageTitle={pageTitle ?? title ?? siteTitle} description={description || settings.data?.tagline} sameAs={sameAs} logo={brand.logoReplaced ? brand.logo?.src : undefined} trail={breadcrumbs} />
		{((site.fonts as { preload?: string[] }).preload ?? []).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
		{googleHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
		{googleHref && <link rel="stylesheet" href={googleHref} />}
		{/* Adobe Fonts project kept from the old site (its licence is tied to the project): middleware.ts allows Typekit then. */}
		{typekitHref && <link rel="stylesheet" href={typekitHref} />}
		{/* Favicons sized for their use (performance package), the captured file when there are none; once an editor picks
		    another favicon in Settings, EmDash's head links it and only its home-screen icon is added here. */}
		{brand.icons.map((i) => <link rel={i.rel} href={i.href} type={i.type || undefined} sizes={i.sizes} />)}
		{/* Verification tags EmDash's head does not print (Settings → SEO prints Google and Bing). */}
		{verification.map(([name, content]) => <meta name={name} content={content} />)}
		{/* Consent banner, then site widgets, then analytics: deferred scripts run in order, so the visitor's choice (or a
		    consent tool) is known before anything else starts. */}
		<Consent />
		{/* RSS autodiscovery (blog sites): the site feed, then this page's own (an archive's). */}
		{/* The page map for AI assistants (pages/llms.txt.ts), named so crawlers and audits find it from any page. */}
		<link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
		{[...blogFeed, ...extraFeeds].map((f) => <link rel="alternate" type="application/rss+xml" title={`${siteTitle} » ${f.title}`} href={f.href} />)}
		{/* Site widgets before analytics: a consent tool starts first (both scripts are deferred, run in order). */}
		<SiteWidgets />
		<Analytics />
	</head>
	<body class:list={{ "over-hero": overHero }}>
		{/* First-visit preloader (Motion): hidden unless site-motion.js shows it; fixed, never takes clicks, gone by 1.2 s. */}
		{preloaderLogo && <div class="motion-preloader" aria-hidden="true" hidden><img src={preloaderLogo.src} width={preloaderLogo.width} height={preloaderLogo.height} alt="" decoding="async" /></div>}
		{/* Customizer "Additional CSS" carried from WordPress by decision (overrides.ts customCss): its own file, linked
		    here so it comes after the starter's bundled CSS (Astro puts that at the end of <head>); never inline (CSP). */}
		{(site as { customCss?: string }).customCss && <link rel="stylesheet" href={(site as { customCss?: string }).customCss} />}
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		{announcement && <Announcement block={announcement} hidden={announcementLater} />}
		<SiteHeader languages={langs?.switcher ?? []} home={langs ? homeOf(langs.lang, (site as { trailingSlash?: "always" | "never" }).trailingSlash) : "/"} primary={primary.data?.items ?? []} secondary={secondary.data?.items ?? []} siteTitle={siteTitle} brand={{ ...(brand.logo ? { logo: brand.logo } : {}), ...(brand.logoOnTop ? { logoOnTop: brand.logoOnTop } : {}) }} socialHref={(href: string) => socialHrefFor(href, s)} />
		<main id="main" tabindex="-1">
			{
				breadcrumbs && breadcrumbs.length > 1 && (
					<nav class="breadcrumbs container" aria-label="Breadcrumb">
						<ol>
							{breadcrumbs.map((c, n) => <li>{c.href && n < breadcrumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
						</ol>
					</nav>
				)
			}
			{
				sidebarAreas.length ? (
					<div class="container with-sidebar">
						<div class="with-sidebar__main"><slot /></div>
						<aside class="site-sidebar" aria-label="Sidebar">{sidebarAreas.map((name) => <WidgetArea name={name} />)}</aside>
					</div>
				) : (
					<slot />
				)
			}
		</main>
		<footer class="site-footer">
			{
				footerAreas.length > 0 && (
					<div class="footer-widgets container">
						<div class="footer-widgets__grid">{footerAreas.map((name) => <WidgetArea name={name} class="footer-widgets__col" />)}</div>
					</div>
				)
			}
			{footer.entry ? <Sections value={footerContent} /> : <p class="container">© {new Date().getFullYear()} {siteTitle}</p>}
			{
				footerMenuItems.length > 0 && (
					<nav class="footer-menu container" aria-label="Footer">
						<ul role="list">
							{footerMenuItems.map((i) => (
								<li>
									<a href={safeHref(i.url) ?? "#"} target={i.target === "_blank" ? "_blank" : undefined} rel={i.target === "_blank" ? "noopener" : undefined}>{i.label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			{/* Name, address, phone, hours (kit.config business.footer; scaffold leaves it out when the footer already shows them; admins hide it in SEO & Analytics → Site checks). */}
			{chrome.businessFooter && <BusinessInfo />}
			{siteCredit && <p class="site-credit container">{siteCredit.text} <a href={siteCredit.url}>{siteCredit.name}</a></p>}
		</footer>
		<Popups popups={popups.entries as any} />
		<EmDashBodyEnd page={pageCtx} />
		<script src="../scripts/site.ts"></script>
	</body>
</html>
