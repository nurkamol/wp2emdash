---
import { getEmDashCollection, getEmDashEntry, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SiteHeader from "../components/SiteHeader.astro";
import Sections from "../components/Sections.astro";
import Popups from "../components/Popups.astro";
import StructuredData from "../components/StructuredData.astro";
import Analytics from "../components/Analytics.astro";
import site from "../site.config.json";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/base.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** First section is a full-bleed hero: the header starts transparent over it. */
	overHero?: boolean;
}
const { title, pageTitle, description, image, canonical, robots, content, overHero } = Astro.props;

const [settings, primary, secondary, footer, popups] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getMenuWithCacheHint("secondary"),
	getEmDashEntry("site_parts", "footer"),
	getEmDashCollection("popups", { status: "published" }),
]);
if (Astro.cache?.enabled) {
	for (const r of [settings, primary, secondary, footer, popups]) Astro.cache.set(r.cacheHint);
}
const siteTitle = settings.data?.title?.trim() || site.name;
const sep = settings.data?.seo?.titleSeparator?.trim() || "-";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} ${sep} ${siteTitle}`) : siteTitle;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || settings.data?.tagline || undefined,
	canonical: canonical ?? `${site.productionUrl}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
	// Structured-data ids use the production origin on every environment (staging is noindex).
	siteUrl: site.productionUrl,
});
const canonicalUrl = canonical ?? `${site.productionUrl}${Astro.url.pathname}`;
/** Google Fonts stylesheet, only when the fonts were not self-hosted at scaffold time. */
const googleHref = (site.fonts as { googleHref?: string }).googleHref;
---

<!doctype html>
<html lang={site.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{/* EmDash's head has no og:locale; SEO plugins publish it (en-US → en_US). */}
		<meta property="og:locale" content={(site as { ogLocale?: string }).ogLocale ?? (site.lang ?? "en").replace("-", "_")} />
		{image && <meta property="og:image:alt" content={pageTitle ?? title ?? siteTitle} />}
		<StructuredData canonical={canonicalUrl} pageTitle={pageTitle ?? title ?? siteTitle} description={description || settings.data?.tagline} />
		{((site.fonts as { preload?: string[] }).preload ?? []).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
		{googleHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
		{googleHref && <link rel="stylesheet" href={googleHref} />}
		{site.favicon && <link rel="icon" href={site.favicon} />}
		{Object.entries((site as { verification?: Record<string, string> }).verification ?? {}).map(([name, content]) => <meta name={name} content={content} />)}
		<Analytics />
	</head>
	<body class:list={{ "over-hero": overHero }}>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<SiteHeader primary={primary.data?.items ?? []} secondary={secondary.data?.items ?? []} siteTitle={siteTitle} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<footer class="site-footer">
			{footer.entry ? <Sections value={(footer.entry.data as any).content} /> : <p class="container">© {new Date().getFullYear()} {siteTitle}</p>}
		</footer>
		<Popups popups={popups.entries as any} />
		<EmDashBodyEnd page={pageCtx} />
		<script src="../scripts/site.ts"></script>
	</body>
</html>
