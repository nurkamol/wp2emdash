---
/**
 * Analytics carried over from the WordPress site (Google tag / GA4, Tag Manager, Cloudflare Web Analytics), from
 * site.config.json. Loaded only on the production domain — never on staging, previews or localhost — and never for
 * signed-in editors (the old site excluded logged-in users too). The loader is a real file (public/scripts/site-analytics.js):
 * Astro inlines small processed <script>s, and the public CSP has no inline-script allowance for them — an inline
 * loader was blocked and no analytics ran on a launched site.
 */
import site from "../site.config.json";
import { isEditor } from "../utils/editor";

const a = (site as { analytics?: { google?: string[]; gtm?: string; cloudflareToken?: string } }).analytics;
const production = Astro.url.host === new URL(site.productionUrl).host;
const on = !!a && production && !import.meta.env.DEV && !isEditor(Astro.cookies, Astro.url);
---

{on && <meta name="site-analytics" content={JSON.stringify(a)} />}
{on && <script is:inline src="/scripts/site-analytics.js" defer></script>}
