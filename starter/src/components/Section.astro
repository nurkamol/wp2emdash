---
/** Shell shared by every section: tone, background (colour/image/video + overlay), spacing, full height, anchor. */
import { Image } from "emdash/ui";
import { mediaUrl } from "../utils/media";

interface Props {
	value: Record<string, any>;
	type: string;
	class?: string;
	/** Extra custom properties from the section's own component (e.g. type sizes). */
	vars?: string;
}
const { value: v, type, class: extra, vars } = Astro.props;
const bg = v.bg_color || undefined;
const resolve = (Astro.locals as any).emdash?.getPublicMediaUrl as ((k: string) => string) | undefined;
const videoSrc = v.bg_video ? mediaUrl(v.bg_video, resolve) : undefined;
const posterSrc = videoSrc && v.bg_image ? mediaUrl(v.bg_image, resolve) : undefined;
const overlay = typeof v.bg_overlay === "number" ? v.bg_overlay : v.bg_image || v.bg_video ? 0 : undefined;
const gradient = /^(?:linear|radial)-gradient\([^;{}<>]*\)$/.test(v.bg_gradient ?? "") ? v.bg_gradient : undefined;
const PAD = /^(?:\d+(?:\.\d+)?px|clamp\([\d.]+px, -?[\d.]+px \+ -?[\d.]+vw, [\d.]+px\))$/;
const padTop = PAD.test(v.pad_top ?? "") ? v.pad_top : undefined;
const padBottom = PAD.test(v.pad_bottom ?? "") ? v.pad_bottom : undefined;
const INSET = /^\d+(?:\.\d+)?(?:px|%|vw)$/;
const inset = [["--row-inset", v.row_inset], ["--row-inset-t", v.row_inset_tablet], ["--row-inset-p", v.row_inset_phone]].filter(([, x]) => INSET.test(x ?? "")).map(([k, x]) => `${k}:${x}`);
const px = (x: unknown) => (typeof x === "number" && x >= 0 && x <= 600 ? `${x}px` : undefined);
const padTopT = padTop ? px(v.pad_top_tablet) : undefined;
const padBottomT = padBottom ? px(v.pad_bottom_tablet) : undefined;
const stackGap = typeof v.stack_gap === "number" && v.stack_gap >= 0 && v.stack_gap <= 200 ? v.stack_gap : undefined;
const style = [padTopT ? `--pad-top-t:${padTopT}` : "", padBottomT ? `--pad-bottom-t:${padBottomT}` : "", stackGap !== undefined ? `--stack-gap:${stackGap}px` : "", ...(INSET.test(v.row_inset ?? "") ? inset : []), padTop ? `--pad-top:${padTop}` : "", padBottom ? `--pad-bottom:${padBottom}` : "", bg ? `--section-bg:${bg}` : "", gradient ? `--section-gradient:${gradient}` : "", overlay !== undefined ? `--section-overlay:${overlay}` : "", vars ?? ""].filter(Boolean).join(";");
---

<section
	id={v.anchor_id || undefined}
	class:list={["section", `section--${type}`, v.variant && `section--${type}--${v.variant}`, `tone-${v.tone ?? "light"}`, `space-${v.spacing ?? "normal"}`, v.valign && `valign-${v.valign}`, { "section--full": v.full_height, "section--media-bg": v.bg_image || v.bg_video, "is-full-width": v.layout_width === "full", "gap-none": v.gap === "none", "has-gradient": gradient, "phone-center": v.phone_align === "center", "tablet-center": v.tablet_align === "center", "has-inset": INSET.test(v.row_inset ?? ""), "quote-centered": v.quote_style === "centered", "head-center": v.head_align === "center", "has-pad-top": !!padTop, "has-pad-bottom": !!padBottom }, extra]}
	style={style || undefined}
	data-reveal
>
	{
		(v.bg_image || v.bg_video) && (
			<div class="section__bg" aria-hidden="true" data-motion={v.bg_motion === "parallax" ? "parallax" : undefined}>
				{v.bg_image && !videoSrc && <Image image={v.bg_image} class="section__bg-media" sizes="100vw" priority={type === "hero" || v._lead === true} />}
				{videoSrc && (
					<video class="section__bg-media" src={videoSrc} poster={posterSrc} autoplay muted loop playsinline preload="auto" disablepictureinpicture data-bg-video />
				)}
				{overlay ? <span class="section__overlay" /> : null}
			</div>
		)
	}
	<div class="section__inner container">
		<slot />
	</div>
</section>
