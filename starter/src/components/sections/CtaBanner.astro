---
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Rich from "../Rich.astro";
import Buttons from "../Buttons.astro";
import Md from "../Md.astro";
import { Image } from "emdash/ui";
const { value: v } = Astro.props as { value: Record<string, any> };
const marquee = v.variant === "marquee";
const words = Array.from({ length: 6 }, () => v.heading ?? "");
---

<Section value={v} type="cta_banner">
	{
		marquee ? (
			<div class="marquee">
				<Heading value={{ ...v, eyebrow: undefined }} class="visually-hidden" />
				{/* The moving line is decoration; one link over the whole section carries the name once. */}
				<span class="marquee__track" aria-hidden="true">
					{words.map((w) => <span class="marquee__item">{w}</span>)}
				</span>
				<a class="marquee__link" href={v.buttons?.[0]?.url ?? "#"}><span class="visually-hidden">{v.heading}</span></a>
				{
					v.media && (
						/* The photo is a window: a white copy of the line, centred on the same point and moving in step, shows through it (Salient's two-layer scrolling text). */
						<div class="marquee__window" aria-hidden="true">
							<Image image={v.media} class="marquee__image" sizes="60vw" />
							<span class="marquee__track marquee__track--over">{words.map((w) => <span class="marquee__item">{w}</span>)}</span>
						</div>
					)
				}
			</div>
		) : (
			<>
				<Heading value={v} />
				<Rich value={v.body} class="lead" />
				<Buttons items={v.buttons} />
			</>
		)
	}
</Section>
