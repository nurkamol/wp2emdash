---
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Rich from "../Rich.astro";
import Buttons from "../Buttons.astro";
import Md from "../Md.astro";
import { Image } from "emdash/ui";
const { value: v } = Astro.props as { value: Record<string, any> };
const members = (v.members ?? []) as Array<Record<string, any>>;
const LENGTH = /^\d+(?:\.\d+)?(?:px|vh|svh|vw|rem|em|%)$/;
const look = [`--cols:${v.columns ?? 3}`, LENGTH.test(v.photo_height ?? "") && `--photo-h:${v.photo_height}`, LENGTH.test(v.name_size ?? "") && `--name-size:${v.name_size}`, LENGTH.test(v.card_gap ?? "") && `--team-gap:${v.card_gap}`].filter(Boolean).join(";");
---

<Section value={v} type="team">
	<Heading value={v} />
	<Rich value={v.intro} />
	<ul class:list={["team", `team--${v.variant ?? "grid"}`]} role="list" style={look}>
		{
			members.map((m, i) => {
				const id = `person-${String(v._key ?? "team").replace(/[^\w-]/g, "")}-${i}`;
				return (
					<li class:list={["person", { "has-bio": !!m.bio, "person--row-end": (i + 1) % (Number(v.columns) || 3) === 0 }]}>
						{m.photo && (
							<div class="person__media">
								<Image image={m.photo} class="person__photo" sizes="(max-width: 1000px) 100vw, 33vw" />
							</div>
						)}
						{m.role && <p class="person__role eyebrow">{m.role}</p>}
						<h3 class="person__name">{m.name}</h3>
						{m.summary && <p class="person__summary">{m.summary}</p>}
						{m.bio && (
							<>
								{/* The whole card opens the full bio (Salient team member, full-screen style). */}
								<button type="button" class="person__open" data-person-open={id} aria-haspopup="dialog">
									<svg class="person__more" aria-hidden="true" width="26" height="10" viewBox="0 0 26 10" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M0 5h25M20 0.5 24.5 5 20 9.5" /></svg>
									<span class="visually-hidden">Read {m.name}'s full bio</span>
								</button>
								<dialog id={id} class="person-modal" aria-label={m.name}>
									<button type="button" class="person-modal__close" data-person-close aria-label="Close" />
									<span class="person-cursor" aria-hidden="true" />
									<div class="person-modal__text">
										{m.role && <p class="person__role eyebrow">{m.role}</p>}
										<h2 class="person-modal__name">{m.name}</h2>
										<Md text={m.bio} class="person-modal__bio" />
									</div>
									{m.photo && (
										<div class="person-modal__photo">
											<Image image={m.photo} sizes="50vw" />
										</div>
									)}
								</dialog>
							</>
						)}
					</li>
				);
			})
		}
	</ul>
</Section>
