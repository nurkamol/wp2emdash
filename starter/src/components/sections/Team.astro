---
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Rich from "../Rich.astro";
import Buttons from "../Buttons.astro";
import Md from "../Md.astro";
import { Image } from "emdash/ui";
const { value: v } = Astro.props as { value: Record<string, any> };
const members = (v.members ?? []) as Array<Record<string, any>>;
---

<Section value={v} type="team">
	<Heading value={v} />
	<Rich value={v.intro} />
	<ul class:list={["team", `team--${v.variant ?? "grid"}`]} role="list">
		{
			members.map((m) => (
				<li class="person">
					{m.photo && <Image image={m.photo} class="person__photo" sizes="(max-width: 900px) 100vw, 33vw" />}
					<h3 class="person__name">{m.name}</h3>
					{m.role && <p class="person__role">{m.role}</p>}
					{m.summary && <p class="person__summary">{m.summary}</p>}
					{m.bio && (
						<details class="person__bio">
							<summary>Read bio</summary>
							<Md text={m.bio} />
						</details>
					)}
				</li>
			))
		}
	</ul>
</Section>
