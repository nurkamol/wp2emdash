---
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Rich from "../Rich.astro";
import Buttons from "../Buttons.astro";
import Md from "../Md.astro";
const { value: v } = Astro.props as { value: Record<string, any> };
---

<Section value={v} type="rich_text" class={`width-${v.width ?? "normal"} align-${v.align ?? "left"}`}>
	<Heading value={v} />
	<Rich value={v.body} />
	<Buttons items={v.buttons} />
</Section>
