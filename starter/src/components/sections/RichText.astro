---
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Rich from "../Rich.astro";
import Buttons from "../Buttons.astro";
import Md from "../Md.astro";
const { value: v } = Astro.props as { value: Record<string, any> };
// Type sizes the builder set on this text, per breakpoint (empty = site defaults).
const LENGTH = /^\d+(?:\.\d+)?(?:px|vh|svh|vw|rem|em|%)$/;
const num = (x: unknown) => (typeof x === "number" && x >= 1 && x <= 3 ? String(x) : undefined);
const pairs: [string, unknown][] = [["--rt-h", v.text_heading_size], ["--rt-h-t", v.text_heading_size_tablet], ["--rt-h-p", v.text_heading_size_phone], ["--rt-h-lh", num(v.text_heading_leading)], ["--rt-p", v.body_size], ["--rt-p-s", v.body_size_small], ["--rt-p-lh", num(v.body_leading)], ["--rt-p-w", v.body_width]];
const style = pairs.flatMap(([k, x]) => (typeof x === "string" && (LENGTH.test(x) || /^\d(?:\.\d+)?$/.test(x)) ? [`${k}:${x}`] : [])).join(";") || undefined;
---

<Section value={v} type="rich_text" class={`width-${v.width ?? "normal"} align-${v.align ?? "left"}`} vars={style}>
	<Heading value={v} />
	<Rich value={v.body} />
	<Buttons items={v.buttons} layout={v} />
</Section>
