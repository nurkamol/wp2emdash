---
/**
 * One product in the shop listing and the category listings (WooCommerce catalogue mode, utils/shop.ts): picture,
 * name, price (sale price with the regular one struck through, "From" for variable products), availability when it is
 * not in stock. The whole card links to the product page; the Buy button lives there. Design tokens only.
 */
import { Image } from "emdash/ui";
import site from "../../site.config.json";
import type { CollectionShop } from "../../utils/collections";
import { availabilityLabel, priceView } from "../../utils/shop";

interface Props {
	href: string;
	data: Record<string, any>;
	shop: CollectionShop;
	eager?: boolean;
}
const { href, data, shop, eager } = Astro.props;
const lang = (site as { lang?: string }).lang ?? "en";
const price = priceView(data, shop, lang);
---

<article class="product-card">
	{
		data.featured_image && (
			<a href={href} class="product-card__media" tabindex="-1" aria-hidden="true">
				<Image image={data.featured_image} sizes="(max-width: 700px) 100vw, 25vw" loading={eager ? "eager" : "lazy"} />
				{price?.onSale && <span class="product-card__badge">Sale</span>}
			</a>
		)
	}
	<h2 class="product-card__title"><a href={href}>{data.title}</a></h2>
	{
		price && (
			<p class="product-card__price">
				{price.from && <span class="product-card__from">From </span>}
				{price.regular && <del>{price.regular}</del>} <span class="product-card__current">{price.current}</span>
			</p>
		)
	}
	{data.stock_status && data.stock_status !== "instock" && <p class="product-card__stock">{availabilityLabel(data.stock_status)}</p>}
</article>

<style>
	.product-card { display: grid; gap: 0.5rem; align-content: start; }
	.product-card__media { position: relative; display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-media, 0); }
	.product-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.product-card__badge { position: absolute; top: 0.75rem; left: 0.75rem; padding: 0.2em 0.6em; font-size: 0.8em; font-weight: 600; background: var(--color-accent); color: var(--color-accent-contrast); border-radius: var(--radius-button); }
	.product-card__title { margin: 0.25rem 0 0; font-family: var(--font-display, inherit); font-size: var(--font-size-h5, 1.15rem); line-height: 1.3; }
	.product-card__title a { color: inherit; text-decoration: none; }
	.product-card__title a:hover, .product-card__title a:focus-visible { text-decoration: underline; }
	.product-card__price { margin: 0; font-weight: 600; }
	.product-card__price del { font-weight: 400; opacity: 0.65; margin-right: 0.35em; }
	.product-card__from { font-weight: 400; }
	.product-card__stock { margin: 0; font-size: 0.9em; opacity: 0.75; }
</style>
