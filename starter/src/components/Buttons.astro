---
/** Buttons/links; a button with `popup` opens that site popup (<dialog>) instead of navigating. */
import { isExternal, safeHref } from "../utils/links";

interface Props {
	items?: Array<{ label?: string; url?: string; style?: string; size?: string; text_size?: string; space_above?: string; new_tab?: boolean; popup?: string }> | null;
	class?: string;
	/** The section's button-group settings (buttons_direction, _align, _width, _stack_phone, _gap); empty = as before. */
	layout?: Record<string, unknown>;
}
const { items, class: extra, layout: l = {} } = Astro.props;
const list = (items ?? []).filter((b) => b?.label);
// Space above the group: the first button that sets its own (px).
const above = list.map((b) => b.space_above).find((x) => /^\d{1,3}px$/.test(x ?? ""));
const pick = <T extends string>(v: unknown, options: readonly T[]) => (options.includes(v as T) ? (v as T) : undefined);
const direction = pick(l.buttons_direction, ["row", "stacked"] as const);
const align = pick(l.buttons_align, ["left", "center", "right", "spread"] as const);
const width = pick(l.buttons_width, ["auto", "equal", "full"] as const);
const gap = typeof l.buttons_gap === "string" && /^\d{1,3}(?:\.\d+)?(?:px|rem)$/.test(l.buttons_gap) ? l.buttons_gap : undefined;
const style = [above && `--actions-above:${above}`, gap && `--actions-gap:${gap}`].filter(Boolean).join(";") || undefined;
---

{
	list.length > 0 && (
		<div class:list={["actions", extra, direction && `actions--${direction}`, align && `actions--align-${align}`, width && `actions--${width}`, l.buttons_stack_phone === true && "actions--stack-phone"]} style={style}>
			{list.map((b) => {
				const href = safeHref(b.url) ?? (b.popup ? `#${b.popup}` : "#");
				return (
					<a
						href={href}
						class:list={["btn", `btn--${b.style ?? "primary"}`, b.size === "large" && "btn--lg"]}
						style={/^\d{2}px$/.test(b.text_size ?? "") ? `--btn-text:${b.text_size}` : undefined}
						data-popup={b.popup || undefined}
						target={b.new_tab ? "_blank" : undefined}
						rel={b.new_tab || isExternal(href) ? "noopener" : undefined}
					>
						<span>{b.label}</span>
					</a>
				);
			})}
		</div>
	)
}
