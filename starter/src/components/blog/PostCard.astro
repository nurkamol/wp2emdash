---
/** A post in a listing: featured image, title, date and byline, excerpt (the post's own, else its first 55 words). */
import { Image } from "emdash/ui";
import { autoExcerpt, ptText } from "../../utils/blog";
import { type PostEntry, postHref } from "../../utils/blog-data";
import PostMeta from "./PostMeta.astro";

interface Props {
	post: PostEntry;
	/** Heading level of the title (h2 on listings). */
	level?: "h2" | "h3";
	/** Load the image eagerly (first card on the page). */
	eager?: boolean;
	/** Parts a latest-posts section chose (default: everything, with the categories). */
	show?: { image: boolean; date: boolean; author: boolean; excerpt: boolean };
}
const { post, level = "h2", eager, show } = Astro.props;
const d = post.data;
const href = postHref(post);
const excerpt = show && !show.excerpt ? "" : (typeof d.excerpt === "string" && d.excerpt.trim()) || autoExcerpt(ptText(d.body));
const image = show ? show.image && d.featured_image : d.featured_image;
const Title = level;
---

<article class:list={["post-card", { "is-featured": d.featured === true }]}>
	{
		image && (
			<a href={href} class="post-card__media" tabindex="-1" aria-hidden="true">
				<Image image={d.featured_image} class="post-card__img" sizes="(max-width: 700px) 100vw, 33vw" loading={eager ? "eager" : "lazy"} />
			</a>
		)
	}
	<div class="post-card__body">
		<Title class="post-card__title"><a href={href}>{d.title}</a></Title>
		{show ? (show.date || show.author) && <PostMeta post={post} showDate={show.date} showAuthor={show.author} showCategories={false} /> : <PostMeta post={post} />}
		{excerpt && <p class="post-card__excerpt">{excerpt}</p>}
	</div>
</article>

<style>
	.post-card { display: grid; gap: 0.9rem; align-content: start; }
	.post-card__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius-media, 0); }
	.post-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.post-card__title { margin: 0; font-family: var(--font-display, inherit); font-size: var(--font-size-h4, 1.35rem); line-height: 1.25; }
	.post-card__title a { color: inherit; text-decoration: none; }
	.post-card__title a:hover, .post-card__title a:focus-visible { text-decoration: underline; }
	.post-card__excerpt { margin: 0; }
</style>
