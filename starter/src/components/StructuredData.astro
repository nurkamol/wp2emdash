---
/**
 * Structured data that EmDash's head does not emit: the business (an Organization or LocalBusiness subtype, carried
 * over from the WordPress site's SEO plugin), this page's WebPage node and its breadcrumb. Node ids join EmDash's own
 * WebSite node (`<origin>/#website`) and the organization id EmDash refers to (`<origin>/#organization`).
 * FAQ sections add their own FAQPage.
 */
import site from "../site.config.json";

interface Props {
	/** Absolute canonical URL of this page. */
	canonical: string;
	/** The page's own title (without the site name). */
	pageTitle: string;
	description?: string | null;
	/** The business's profiles with Settings → Social Links applied (utils/settings.ts sameAsWithSocial). */
	sameAs?: string[];
	/** The logo an editor picked in Settings → General (else the migrated brand logo). */
	logo?: string;
}
const { canonical, pageTitle, description, sameAs: sameAsProp, logo: logoProp } = Astro.props;

type Business = { type: string; name: string; description?: string; url?: string; email?: string; telephone?: string; priceRange?: string; address?: Record<string, string>; geo?: { latitude: string; longitude: string }; hasMap?: string; openingHours?: string[]; sameAs?: string[] };
const sd = (site as { structuredData?: { business?: Business; pageTypes?: Record<string, string> } }).structuredData ?? {};
const origin = new URL(site.productionUrl).origin;
const path = new URL(canonical).pathname;
const isHome = path === "/";
const orgId = `${origin}/#organization`;
const logo = logoProp ?? (site as { header?: { logo?: string } }).header?.logo;
const b = sd.business;

const graph: Record<string, unknown>[] = [];
const logoUrl = logo ? new URL(logo, origin).href : undefined;
const local = b && b.type !== "Organization";
if (b) {
	// Logo and place as their own nodes, linked from the business (as SEO plugins publish them).
	if (logoUrl) graph.push({ "@type": "ImageObject", "@id": `${origin}/#logo`, url: logoUrl, contentUrl: logoUrl, caption: b.name });
	if (local && (b.geo || b.address)) graph.push({ "@type": "Place", "@id": `${origin}/#place`, ...(b.geo ? { geo: { "@type": "GeoCoordinates", ...b.geo } } : {}), ...(b.hasMap ? { hasMap: b.hasMap } : {}), ...(b.address ? { address: { "@type": "PostalAddress", ...b.address } } : {}) });
	graph.push({
		"@type": b.type === "Organization" ? "Organization" : [b.type, "Organization"],
		"@id": orgId,
		name: b.name,
		url: `${origin}/`,
		...(b.description ? { description: b.description } : {}),
		...(logoUrl ? { logo: { "@id": `${origin}/#logo` }, image: { "@id": `${origin}/#logo` } } : {}),
		...(b.email ? { email: b.email } : {}),
		...(b.telephone ? { telephone: b.telephone } : {}),
		...(b.priceRange && b.type !== "Organization" ? { priceRange: b.priceRange } : {}),
		...(b.address ? { address: { "@type": "PostalAddress", ...b.address } } : {}),
		...(local && (b.geo || b.address) ? { location: { "@id": `${origin}/#place` } } : {}),
		...(b.geo && local ? { geo: { "@type": "GeoCoordinates", ...b.geo } } : {}),
		...(b.hasMap ? { hasMap: b.hasMap } : {}),
		...(b.openingHours?.length && b.type !== "Organization" ? { openingHours: b.openingHours } : {}),
		...((sameAsProp ?? b.sameAs)?.length ? { sameAs: sameAsProp ?? b.sameAs } : {}),
	});
}
graph.push({
	"@type": sd.pageTypes?.[path] ?? "WebPage",
	"@id": `${canonical}#webpage`,
	url: canonical,
	name: pageTitle,
	...(description ? { description } : {}),
	isPartOf: { "@id": `${origin}/#website` },
	...(b ? { [isHome ? "about" : "publisher"]: { "@id": orgId } } : {}),
	...(!isHome ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } } : {}),
	inLanguage: site.lang,
});
if (!isHome) {
	graph.push({
		"@type": "BreadcrumbList",
		"@id": `${canonical}#breadcrumb`,
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
			{ "@type": "ListItem", position: 2, name: pageTitle, item: canonical },
		],
	});
}
// JSON in a script element: "<" escaped so content can never close the tag.
const json = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
