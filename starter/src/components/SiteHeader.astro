---
/**
 * Header + mobile/burger menu. Arrangement, panel and motion come from the audit (src/site.config.json
 * and styles/motion.css), so they are data, not code:
 * - layout "centered": toggle | logo | actions  (Salient "centered-logo…" and similar)
 * - layout "logo-left": logo | inline nav | actions + toggle
 * Accessible regardless of the source: real <button>, aria-expanded/controls, focus trap, Esc,
 * focus return, inert page, scroll lock, prefers-reduced-motion = instant.
 */
import site from "../site.config.json";
import { safeHref } from "../utils/links";
import { readableFill } from "../utils/announcement";

interface Item {
	label: string;
	url: string;
	target?: string | null;
	/** A header button's second label (shown on hover), from the menu item's title attribute. */
	titleAttr?: string | null;
	cssClasses?: string | null;
	children?: Item[];
}
interface Props {
	primary: Item[];
	secondary: Item[];
	siteTitle: string;
	/** Logo and light logo from Settings → General with site.config as fallback (utils/settings.ts siteBrand); omitted = site.config. */
	brand?: { logo?: LogoImg; logoOnTop?: LogoImg };
	/** Settings → Social Links: the panel's social icons point at these profiles. */
	socialHref?: (href: string) => string;
}
const { primary, secondary, siteTitle, brand, socialHref } = Astro.props;
const h = site.header as typeof site.header & { layout?: string; inlineNav?: boolean; togglePosition?: string; toggleLabel?: string; logo?: string; logoOnTop?: string; logoImg?: LogoImg; logoOnTopImg?: LogoImg };
/** The logo files as the performance package made them (content-hashed, WebP when smaller, intrinsic size). */
type LogoImg = { src: string; width?: number; height?: number };
const logo = brand ? brand.logo : (h.logoImg ?? (h.logo ? { src: h.logo } : undefined));
const logoOnTop = brand ? brand.logoOnTop : (h.logoOnTopImg ?? (h.logoOnTop ? { src: h.logoOnTop } : undefined));
const layout = h.layout ?? "logo-left";
const inlineNav = h.inlineNav ?? true;
const toggleLeft = h.togglePosition === "left";
const popupOf = (i: Item) => /(?:^|\s)popup-([\w-]+)/.exec(i.cssClasses ?? "")?.[1];
const isButton = (i: Item) => !!popupOf(i) || /(?:^|\s)button(?:\s|$)/.test(i.cssClasses ?? "");
const isPhone = (i: Item) => /^tel:/i.test(i.url);
/** A mega menu panel on the source (menu item class `mega`): its children are column headings with their links under them. */
const isMega = (i: Item) => /(?:^|\s)mega(?:\s|$)/.test(i.cssClasses ?? "");
const blank = (i: Item) => (i.target === "_blank" ? { target: "_blank", rel: "noopener" } : {});
/** The old header had a search icon (audit): a link to the search page. */
const searchHref = (h as { search?: boolean }).search ? ((site as { trailingSlash?: string }).trailingSlash === "never" ? "/search" : "/search/") : undefined;
const path = Astro.url.pathname;
// Without a panel capture, the secondary links (minus buttons already in the header) lead the panel.
const extras = (h as { panelExtras?: { lead: { label: string; href: string; smallOnly?: boolean }[]; contacts: { icon: string; href: string; label: string }[]; credit: boolean; buttons?: boolean } }).panelExtras ?? {
	lead: secondary.filter((i) => !isButton(i)).map((i) => ({ label: i.label, href: i.url })),
	contacts: [],
	credit: false,
	buttons: false,
};
// The header's buttons repeated in the panel, after the menu (the source's panel shows them there).
const panelButtons = extras.buttons ? secondary.filter(isButton) : [];
const hoverOf = (i: Item) => (isButton(i) && i.titleAttr?.trim() && i.titleAttr.trim() !== i.label.trim() ? i.titleAttr.trim() : undefined);
// Bricks header look (site.config header.bricks; other builders never set it): the bar in the content width, the toggle
// and the buttons per screen, button colours and corners, and an offcanvas sheet with its own logo, close and buttons.
type HN = { navGap?: string };
type HB = { label: string; bg?: string; color?: string; radius?: number; padY?: number; padX?: number };
const bx = (h as { bricks?: { gutter?: { mobile: number; desktop: number }; toggleSmallOnly?: boolean; buttonsHidePhone?: boolean; buttons?: HB[]; panel?: { pad?: string; logoGap?: string; itemGap?: string; buttonsGap?: string; closeInset?: string; closeSize?: number; logoHeight?: number; width?: number; buttons?: HB[] }; panelStyle?: Record<string, string | number> } }).bricks;
const COLOR = /^(?:#[0-9a-f]{3,8}|rgba?\([\d\s.,%]+\))$/i;
const LEN = /^(?:\d+(?:\.\d+)?px|clamp\([\d.]+px, -?[\d.]+px \+ -?[\d.]+vw, [\d.]+px\))$/;
const num = (x: unknown, lo: number, hi: number) => (typeof x === "number" && Number.isFinite(x) && x >= lo && x <= hi ? x : undefined);
const fluidPx = (a: number, b: number) => (Math.abs(a - b) < 0.5 ? `${b}px` : `clamp(${Math.min(a, b)}px, ${Math.round((a - ((b - a) / 1050) * 390) * 100) / 100}px + ${Math.round(((b - a) / 1050) * 100000) / 1000}vw, ${Math.max(a, b)}px)`);
const lookOf = (i: Item, list: HB[] | undefined) => {
	const b = list?.find((x) => x.label.trim().toLowerCase() === String(i.label ?? "").trim().toLowerCase());
	if (!b) return undefined;
	const r = num(b.radius, 0, 200);
	const y = num(b.padY, 0, 60);
	const x = num(b.padX, 0, 80);
	// The source's colours, the fill a shade darker only where white text would miss WCAG AA (verify gates on it).
	const bg = readableFill(b.bg, b.color);
	return [COLOR.test(bg ?? "") && `--hb-bg:${bg}`, COLOR.test(b.color ?? "") && `--hb-color:${b.color}`, r !== undefined && `--hb-radius:${r}px`, y !== undefined && x !== undefined && `--hb-pad:${y}px ${x}px`].filter(Boolean).join(";");
};
const bxPanel = bx?.panel;
const ps = bx?.panelStyle ?? {};
const sheetStyle = bxPanel
	? [
			LEN.test(bxPanel.pad ?? "") && `--sheet-pad:${bxPanel.pad}`,
			LEN.test(bxPanel.logoGap ?? "") && `--sheet-logo-gap:${bxPanel.logoGap}`,
			LEN.test(bxPanel.itemGap ?? "") && `--sheet-item-gap:${bxPanel.itemGap}`,
			LEN.test(bxPanel.buttonsGap ?? "") && `--sheet-buttons-gap:${bxPanel.buttonsGap}`,
			LEN.test(bxPanel.closeInset ?? "") && `--sheet-close-inset:${bxPanel.closeInset}`,
			num(bxPanel.closeSize, 12, 80) && `--sheet-close-size:${bxPanel.closeSize}px`,
			num(bxPanel.logoHeight, 20, 300) && `--sheet-logo-h:${bxPanel.logoHeight}px`,
			num(bxPanel.width, 200, 2000) && `--sheet-w:${bxPanel.width}px`,
			COLOR.test(String(ps.bg ?? "")) && `--sheet-bg:${ps.bg}`,
			COLOR.test(String(ps.color ?? "")) && `--sheet-color:${ps.color}`,
			num(ps.weight, 100, 900) && `--sheet-weight:${ps.weight}`,
			/^\d+(?:\.\d+)?px$/.test(String(ps.lineHeight ?? "")) && `--sheet-lh:${ps.lineHeight}`,
			ps.font === "body" && "--sheet-font:var(--font-body)",
			num(ps.ms, 0, 3000) !== undefined && `--sheet-ms:${ps.ms}ms`,
			/^(?:ease|linear|ease-in|ease-out|ease-in-out|cubic-bezier\([\d.,\s-]+\))$/.test(String(ps.ease ?? "")) && `--sheet-ease:${ps.ease}`,
		]
			.filter(Boolean)
			.join(";")
	: undefined;
const overlayStyle = bxPanel && COLOR.test(String(ps.overlay ?? "")) ? `--menu-overlay-bg:${ps.overlay};--menu-overlay-opacity:1` : undefined;
const navGap = (bx as HN | undefined)?.navGap;
const headerStyle = [bx?.gutter && num(bx.gutter.mobile, 0, 200) !== undefined && num(bx.gutter.desktop, 0, 200) !== undefined ? `--gutter-header:${fluidPx(bx.gutter.mobile, bx.gutter.desktop)}` : "", LEN.test(navGap ?? "") ? `--hnav-gap:${navGap}` : ""].filter(Boolean).join(";") || undefined;
const ICONS: Record<string, string> = {
	phone: "M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z",
	email: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z",
	instagram: "M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2c-2.7 0-3.1 0-4.1.1C4.3 2.3 2.3 4.2 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.2 3.6 2.1 5.6 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.2 5.6-2.1 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.2-3.6-2.1-5.6-5.8-5.8C15.1 2 14.7 2 12 2z",
	facebook: "M14 13.5h2.5l1-4H14v-2c0-1 0-2 2-2h1.5V2.1A28 28 0 0 0 14.6 2C12 2 10 3.7 10 6.7v2.8H7v4h3V22h4z",
	link: "M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7",
};
---

<header
	class:list={["site-header", `layout-${layout}`, `panel-${h.panel}`, { "is-transparent": h.transparentOnTop, "hides-on-scroll": h.hideOnScroll, "has-inline-nav": inlineNav, "toggle-left": toggleLeft, "has-bar-container": !!bx, "toggle-small-only": bx?.toggleSmallOnly === true, "hb-hide-phone": bx?.buttonsHidePhone === true }]}
	style={headerStyle}
	data-header
>
	<div class="site-header__bar container">
		{
			toggleLeft && (
				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
					<span class="menu-toggle__icon" aria-hidden="true"><i class="menu-toggle__line" /><i class="menu-toggle__line" /><i class="menu-toggle__line" /></span>
					{h.toggleLabel ? <span class="menu-toggle__label">{h.toggleLabel}</span> : <span class="visually-hidden">Menu</span>}
				</button>
			)
		}
		<a href="/" class="site-header__logo" aria-label={`${siteTitle} — home`}>
			{logo ? <img {...logo} alt="" class="logo logo--default" decoding="async" /> : <span class="wordmark">{siteTitle}</span>}
			{logoOnTop && <img {...logoOnTop} alt="" class="logo logo--top" decoding="async" />}
		</a>
		{
			inlineNav && (
				<nav class="site-header__nav" aria-label="Main">
					<ul role="list">
						{primary.map((i) => (
							<li>
								<a href={safeHref(i.url) ?? "#"} aria-current={i.url === path ? "page" : undefined} {...blank(i)}>
									{i.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
		<div class="site-header__actions">
			{
				searchHref && (
					<a href={searchHref} class="header-link header-search" aria-label="Search">
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
					</a>
				)
			}
			{secondary.map((i) => {
				const popup = popupOf(i);
				return (
					<a href={safeHref(i.url) ?? "#"} class:list={["header-link", { "btn btn--primary": isButton(i), "header-link--phone": isPhone(i), "has-hover-label": !!hoverOf(i), "has-look": isButton(i) && !!lookOf(i, bx?.buttons) }]} style={isButton(i) ? lookOf(i, bx?.buttons) || undefined : undefined} data-popup={popup} target={i.target === "_blank" ? "_blank" : undefined} rel={i.target === "_blank" ? "noopener" : undefined}>
						{isPhone(i) && (
							<svg class="header-link__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
							</svg>
						)}
						{(() => {
							const hover = hoverOf(i);
							if (hover)
								return (
									<span class="btn__labels">
										<span class="btn__label">{i.label}</span>{" "}
										<span class="btn__hover" aria-hidden="true">{hover}</span>
									</span>
								);
							// A button label of several words shows only its first word on phones ("Book Now" → "Book").
							const short = isButton(i) ? String(i.label ?? "").trim().split(/\s+/)[0] : undefined;
							return short && short !== String(i.label).trim() ? (
								<span>
									<span class="label-full">{i.label}</span>
									<span class="label-short" aria-hidden="true">{short}</span>
								</span>
							) : (
								<span>{i.label}</span>
							);
						})()}
					</a>
				);
			})}
			{
				!toggleLeft && (
					<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
						<span class="menu-toggle__icon" aria-hidden="true"><i class="menu-toggle__line" /><i class="menu-toggle__line" /><i class="menu-toggle__line" /></span>
						{h.toggleLabel ? <span class="menu-toggle__label">{h.toggleLabel}</span> : <span class="visually-hidden">Menu</span>}
					</button>
				)
			}
		</div>
	</div>
</header>
<div class="menu-overlay" data-menu-overlay hidden style={overlayStyle}></div>
<div id="menu-panel" class:list={["menu-panel", `menu-panel--${h.panel}`, { "menu-panel--sheet": !!bxPanel, "from-right": ps.from === "right" }]} role="dialog" aria-modal="true" aria-label="Menu" data-menu-panel hidden style={[h.panelItemSize ? `--menu-item-size:${h.panelItemSize}` : "", sheetStyle ?? ""].filter(Boolean).join(";") || undefined}>
	{
		bxPanel && (
			<div class="menu-panel__top">
				<a href="/" class="menu-panel__logo" aria-label={`${siteTitle} — home`}>
					{/* Same file as the header logo (already loaded): no lazy loading, nothing to wait for. */}
					{logo ? <img {...logo} alt="" decoding="async" /> : <span class="wordmark">{siteTitle}</span>}
				</a>
				<button type="button" class="menu-panel__close" data-menu-close>
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13" /></svg>
					<span class="visually-hidden">Close menu</span>
				</button>
			</div>
		)
	}
	<nav aria-label="Mobile">
		<ul class="menu-panel__items" role="list">
			{
				extras.lead.map((i, n) => (
					<li style={`--i:${n}`} class:list={["menu-panel__lead", { "small-only": "smallOnly" in i && i.smallOnly }]}>
						<a href={safeHref(i.href) ?? "#"}>{i.label}</a>
					</li>
				))
			}
			{
				primary.map((i, n) => (
					<li style={`--i:${extras.lead.length + n}`} class:list={{ "has-children": i.children && i.children.length > 0 }}>
						<a href={safeHref(i.url) ?? "#"} aria-current={i.url === path ? "page" : undefined} {...blank(i)}>
							{i.label}
						</a>
						{i.children && i.children.length > 0 && (
							<>
								<button type="button" class="menu-panel__sub-toggle" aria-expanded="false" aria-controls={`sub-${n}`} data-submenu-toggle>
									<span class="visually-hidden">Show {i.label} pages</span>
									<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6" /></svg>
								</button>
								<ul role="list" id={`sub-${n}`} class:list={["menu-panel__sub", { "menu-panel__mega": isMega(i) }]}>
									{i.children.map((c) => (
										<li class:list={{ "menu-panel__col": isMega(i) && !!c.children?.length }}>
											<a href={safeHref(c.url) ?? "#"} {...blank(c)}>{c.label}</a>
											{c.children && c.children.length > 0 && (
												<ul role="list" class="menu-panel__deep">
													{c.children.flatMap((g) => [g, ...(g.children ?? [])]).map((g) => (
														<li>
															<a href={safeHref(g.url) ?? "#"} {...blank(g)}>{g.label}</a>
														</li>
													))}
												</ul>
											)}
										</li>
									))}
								</ul>
							</>
						)}
					</li>
				))
			}
		</ul>
		{
			panelButtons.length > 0 && (
				<ul class="menu-panel__buttons" role="list">
					{panelButtons.map((i, n) => {
						const hover = hoverOf(i);
						return (
							<li style={`--i:${extras.lead.length + primary.length + n}`}>
								<a href={safeHref(i.url) ?? "#"} class:list={["btn btn--primary", { "has-hover-label": !!hover, "has-look": !!lookOf(i, bxPanel?.buttons ?? bx?.buttons) }]} style={lookOf(i, bxPanel?.buttons ?? bx?.buttons) || undefined} data-popup={popupOf(i)} target={i.target === "_blank" ? "_blank" : undefined} rel={i.target === "_blank" ? "noopener" : undefined}>
									{hover ? (
										<span class="btn__labels">
											<span class="btn__label">{i.label}</span>{" "}
											<span class="btn__hover" aria-hidden="true">{hover}</span>
										</span>
									) : (
										<span>{i.label}</span>
									)}
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
		{
			extras.contacts.length > 0 && (
				<ul class="menu-panel__contacts" role="list" style={`--i:${extras.lead.length + primary.length}`}>
					{extras.contacts.map((c) => ({ ...c, href: socialHref ? socialHref(c.href) : c.href })).map((c) => (
						<li>
							<a href={safeHref(c.href) ?? "#"} target={/^https?:/.test(c.href) ? "_blank" : undefined} rel={/^https?:/.test(c.href) ? "noopener" : undefined}>
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d={ICONS[c.icon] ?? ICONS.link} /></svg>
								<span class="visually-hidden">{c.label}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
		{extras.credit && <p class="menu-panel__credit" style={`--i:${extras.lead.length + primary.length + 1}`}>© {new Date().getFullYear()} <a href="/">{siteTitle}</a></p>}
	</nav>
</div>
