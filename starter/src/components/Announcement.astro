---
/**
 * Announcement bar above the header (site part "announcement", block section_announcement).
 * Rendered on the server, so it is in the HTML and in the first paint. A tiny inline script right after it
 * (before the header and the page are parsed) decides visibility in the browser — the visitor closed this message
 * version, or the schedule (starts_at / ends_at) says so — because a cached page outlives the request that rendered
 * it. It measures the bar's height into --announce-h: the header and the page move down by exactly that, before
 * anything paints, so there is no layout shift. Without JavaScript the server's decision stands (Base.astro also
 * shortens the page's cache lifetime to the next schedule change). Scroll, resize and close: scripts/site.ts.
 * Accessible: a labelled region, a real close button, text colour raised to WCAG AA when it is too faint.
 */
import Rich from "./Rich.astro";
import { safeHref, isExternal } from "../utils/links";
import { announcementVersion, readableText } from "../utils/announcement";
import announcementScript from "../scripts/inline/announcement.js?raw";

interface Props {
	block: {
		enabled?: boolean;
		message?: any[];
		buttons?: { label?: string; url?: string; style?: string; new_tab?: boolean }[];
		bg_color?: string;
		text_color?: string;
		button_bg?: string;
		button_color?: string;
		dismissible?: boolean;
		sticky?: boolean;
		starts_at?: string;
		ends_at?: string;
	};
	/** Outside its schedule when the page was rendered (starts later): in the HTML but hidden until the script shows it. */
	hidden?: boolean;
}
const { block: b, hidden } = Astro.props;
const buttons = (b.buttons ?? []).filter((x) => x?.label).slice(0, 2);
const bg = b.bg_color || undefined;
const text = readableText(bg, b.text_color || undefined);
const btnBg = b.button_bg || text;
const btnText = readableText(btnBg, b.button_color || bg);
const version = announcementVersion(b);
const at = (v?: string) => (v && !Number.isNaN(Date.parse(v)) ? String(Date.parse(v)) : undefined);
const style = [bg && `--announce-bg:${bg}`, text && `--announce-color:${text}`, btnBg && `--announce-btn-bg:${btnBg}`, btnText && `--announce-btn-color:${btnText}`].filter(Boolean).join(";") || undefined;
---

<section class="announcement" aria-label="Announcement" data-announcement data-version={version} data-sticky={b.sticky ? "" : undefined} data-dismissible={b.dismissible ? "" : undefined} data-from={at(b.starts_at)} data-to={at(b.ends_at)} hidden={hidden} style={style}>
	<div class="announcement__inner container">
		<Rich value={b.message} class="announcement__message" />
		{
			buttons.length > 0 && (
				<div class="announcement__actions">
					{buttons.map((x) => {
						const href = safeHref(x.url) ?? "#";
						return (
							<a class:list={["announcement__btn", x.style === "secondary" && "announcement__btn--secondary"]} href={href} target={x.new_tab ? "_blank" : undefined} rel={x.new_tab || isExternal(href) ? "noopener" : undefined}>
								{x.label}
							</a>
						);
					})}
				</div>
			)
		}
	</div>
	{
		b.dismissible && (
			<button type="button" class="announcement__close" data-announcement-close aria-label="Close announcement">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z" /></svg>
			</button>
		)
	}
</section>
{/* The pre-paint script is a fixed text (scripts/inline/announcement.js): the public Content-Security-Policy allows it
   by its SHA-256 hash (middleware.ts), never with 'unsafe-inline'. */}
<script is:inline set:html={announcementScript} />
