{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "emdash": [
        "./test/stubs/emdash.ts"
      ],
      "cloudflare:workers": [
        "./test/stubs/cloudflare-workers.ts"
      ],
      "astro": [
        "./test/stubs/astro.ts"
      ],
      "@cf-wasm/satori": [
        "./test/stubs/cf-wasm-satori.ts"
      ],
      "@cf-wasm/resvg": [
        "./test/stubs/cf-wasm-resvg.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages",
    "test",
    "sites/*/kit.config.ts",
    "sites/*/overrides.ts"
  ]
}
