{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "emdash": [
        "./test/stubs/emdash.ts"
      ],
      "emdash/runtime": [
        "./test/stubs/emdash-runtime.ts"
      ],
      "emdash/middleware": [
        "./test/stubs/emdash-middleware.ts"
      ],
      "cloudflare:workers": [
        "./test/stubs/cloudflare-workers.ts"
      ],
      "astro": [
        "./test/stubs/astro.ts"
      ],
      "react": [
        "./test/stubs/react.ts"
      ],
      "@cf-wasm/satori": [
        "./test/stubs/cf-wasm-satori.ts"
      ],
      "@cf-wasm/resvg": [
        "./test/stubs/cf-wasm-resvg.ts"
      ],
      "@wp2emdash/forms/*": [
        "./packages/forms/src/*.ts"
      ],
      "@wp2emdash/seo/*": [
        "./packages/seo/src/*.ts"
      ],
      "@wp2emdash/consent/*": [
        "./packages/consent/src/*.ts"
      ],
      "@wp2emdash/motion/*": [
        "./packages/motion/src/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages",
    "test",
    "e2e",
    "sites/*/kit.config.ts",
    "sites/*/overrides.ts"
  ]
}
