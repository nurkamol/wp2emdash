node_modules/
.DS_Store
*.tmp
# Spike projects are throwaway; findings live in docs/spikes/
spikes/*/
# Client workspaces never enter this (public) repo: they hold client content, credentials and
# exports. Each one is a local folder, optionally its own private repo. Only the README is tracked.
sites/*
!sites/README.md
# Kit-level secrets shared by every site (e.g. the agency's Cloudflare API token)
.env
.env.*
!.env.example

# Claude Code agent worktrees and local settings
.claude/worktrees/
.wp2emdash.local.json

# The agency monitor (wp2emdash monitor init|build): client domains + agency alert address
/monitor/

# Sales estimates (wp2emdash estimate): prospect data, never committed
/estimates/

# WordPress end-to-end test (docs/e2e.md): generated seed files, plugin zips, reports
e2e/wordpress/.work/
/e2e-report/
/.e2e-cache/

# Private patterns for scripts/privacy-check.mjs (client names the check cannot derive from sites/)
.privacy-patterns
