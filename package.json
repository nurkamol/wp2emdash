{
  "name": "wp2emdash",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Migrates WordPress sites (WPBakery/Salient, Gutenberg, classic) to EmDash on Cloudflare Workers, with automated verification gates.",
  "type": "module",
  "bin": {
    "wp2emdash": "./bin/wp2emdash.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wp2emdash": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.12.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./config": "./src/config/schema.ts"
  },
  "packageManager": "pnpm@11.18.0"
}
