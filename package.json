{
  "name": "wp2emdash",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Migrates WordPress sites (WPBakery/Salient, Gutenberg, classic) to EmDash on Cloudflare Workers, with automated verification gates.",
  "type": "module",
  "bin": {
    "wp2emdash": "./bin/wp2emdash.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wp2emdash": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@emdash-cms/gutenberg-to-portable-text": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "axe-core": "^4.14.1",
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.12.1",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./config": "./src/config/schema.ts"
  },
  "packageManager": "pnpm@11.18.0",
  "author": "Nurkamol Vokhidov (https://github.com/nurkamol)",
  "homepage": "https://nurkamol.github.io/wp2emdash/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurkamol/wp2emdash.git"
  },
  "bugs": {
    "url": "https://github.com/nurkamol/wp2emdash/issues"
  },
  "keywords": [
    "wordpress",
    "emdash",
    "migration",
    "astro",
    "cloudflare-workers",
    "d1",
    "r2",
    "wpbakery",
    "gutenberg",
    "bricks",
    "elementor"
  ]
}
