{
  "id": "fluent-forms-14",
  "title": "Class interest (synthetic)",
  "submitLabel": "Send",
  "successMessage": "Thank you — we will be in touch.",
  "fields": [
    {
      "name": "first_name",
      "label": "First Name",
      "type": "text",
      "required": true,
      "autocomplete": "given-name"
    },
    {
      "name": "middle_name",
      "label": "Middle Name",
      "type": "text",
      "autocomplete": "additional-name"
    },
    {
      "name": "last_name",
      "label": "Last Name",
      "type": "text",
      "required": true,
      "autocomplete": "family-name"
    },
    {
      "name": "email",
      "label": "Email",
      "type": "email",
      "required": true,
      "autocomplete": "email"
    },
    {
      "name": "checkbox",
      "label": "Which classes interest you?",
      "type": "checkbox",
      "options": [
        "Mat basics",
        "Reformer flow",
        "Barre fusion",
        "Prenatal",
        "Something else (tell us)"
      ]
    },
    {
      "name": "input_text",
      "label": "What else would you like to try?",
      "type": "text",
      "required": true,
      "showIf": {
        "field": "checkbox",
        "equals": [
          "Something else (tell us)"
        ]
      }
    },
    {
      "name": "checkbox_1",
      "label": "Preferred times",
      "type": "checkbox",
      "options": [
        "Mornings",
        "Evenings"
      ],
      "showIf": {
        "field": "checkbox",
        "equals": [
          "Mat basics",
          "Reformer flow",
          "Barre fusion",
          "Prenatal"
        ]
      }
    }
  ],
  "warnings": []
}
