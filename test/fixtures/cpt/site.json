	"fieldDefinitions": {
		"acf-team.json": {
			"provider": "acf",
			"file": "acf-export-2024-05-01.json",
			"data": [
				{
					"key": "group_team",
					"title": "Team member",
					"location": [[{ "param": "post_type", "operator": "==", "value": "team" }]],
					"fields": [
						{ "key": "field_role", "label": "Role", "name": "role", "type": "text", "required": 1 },
						{ "key": "field_photo", "label": "Photo", "name": "photo", "type": "image", "return_format": "array" },
						{ "key": "field_bio", "label": "Biography", "name": "bio", "type": "wysiwyg" },
						{ "key": "field_tab", "label": "More", "name": "", "type": "tab" },
						{ "key": "field_start", "label": "Teaching since", "name": "start_date", "type": "date_picker", "return_format": "F j, Y" },
						{ "key": "field_level", "label": "Level", "name": "level", "type": "select", "choices": { "junior": "Junior", "senior": "Senior" } },
						{ "key": "field_accepts", "label": "Takes new clients", "name": "accepts_clients", "type": "true_false" },
						{ "key": "field_skills", "label": "Skills", "name": "skills", "type": "repeater", "sub_fields": [{ "key": "field_skill", "label": "Skill", "name": "skill", "type": "text" }, { "key": "field_years", "label": "Years", "name": "years", "type": "number" }] },
						{ "key": "field_related", "label": "Works with", "name": "related", "type": "relationship", "post_type": ["team"] },
						{ "key": "field_gallery", "label": "Gallery", "name": "gallery", "type": "gallery" },
						{ "key": "field_link", "label": "Profile link", "name": "profile_link", "type": "link" }
					]
				}
			]
		},
		"metabox-services.json": {
			"provider": "metabox",
			"file": "meta-box-export.json",
			"data": [{ "post_title": "Service details", "meta_box": { "id": "service-details", "title": "Service details", "post_types": ["services"], "fields": [{ "id": "price", "name": "Price", "type": "number" }, { "id": "duration", "name": "Duration", "type": "text" }, { "id": "photos", "name": "Photos", "type": "image_advanced" }, { "id": "booking_url", "name": "Booking link", "type": "url" }] } }]
		},
		"pods-location.json": {
			"provider": "pods",
			"file": "pods-package.json",
			"data": { "@meta": { "version": "3.2.0" }, "pods": [{ "name": "location", "label": "Locations", "type": "post_type", "fields": [{ "name": "address", "label": "Address", "type": "paragraph" }, { "name": "website", "label": "Website", "type": "website" }, { "name": "open_weekends", "label": "Open at weekends", "type": "boolean" }, { "name": "phone", "label": "Phone", "type": "phone" }, { "name": "services_offered", "label": "Services", "type": "pick", "pick_object": "post_type", "pick_val": "services", "pick_format_type": "multi" }] }] }
		}
