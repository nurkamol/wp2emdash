{
  "name": "@wp2emdash/forms",
  "version": "1.11.0",
  "description": "Website forms for EmDash on Cloudflare Workers: form endpoint, email delivery, KV outbox, chat and CRM sync, and a Form messages admin page",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./endpoint": "./src/endpoint.ts",
    "./outbox": "./src/outbox.ts",
    "./deliver": "./src/deliver.ts",
    "./plugin": "./src/plugin/index.ts",
    "./types": "./src/types.ts",
    "./rich": "./src/rich.ts",
    "./signature": "./src/signature.ts",
    "./signature-pad": "./src/signature-pad.ts",
    "./logic": "./src/logic.ts",
    "./uploads": "./src/uploads.ts",
    "./chat": "./src/chat.ts",
    "./crm": "./src/crm.ts",
    "./webmcp": "./src/webmcp.ts",
    "./prefill": "./src/prefill.ts"
  },
  "files": ["src", "README.md"],
  "peerDependencies": {
    "astro": ">=7.4",
    "emdash": ">=1.5 <2"
  },
  "engines": { "node": ">=24" }
